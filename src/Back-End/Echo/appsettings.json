{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=echo.db"
  },
  "RateLimiting": {
    "CreatePerMinute": 5,
    "ReadPerMinute": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Paste": {
    "MaxContentBytes": 51200
  },
  "DatabaseMaintenance": {
    "MaxSizeBytes": 104857600,
    "CheckIntervalMinutes": 60,
    "DeletionBatchSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
