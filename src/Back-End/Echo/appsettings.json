{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=echo;Username=echo;Password=echo_password"
  },
  "RateLimiting": {
    "CreatePerMinute": 5,
    "ReadPerMinute": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Proxy": {
    "TrustedNetworks": [
      "127.0.0.1/8",
      "::1/128"
    ]
  },
  "Paste": {
    "MaxContentBytes": 51200
  },
  "DatabaseMaintenance": {
    "MaxSizeBytes": 104857600,
    "CheckIntervalMinutes": 60,
    "DeletionBatchSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
